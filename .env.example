# InterfaceForge Configuration Template

# Application & Host Settings
APP_NAME="InterfaceForge Backend"
ENVIRONMENT="development"
DEBUG=true
PORT=8000

# Database Settings
DB_PATH="artifacts/interfaceforge.db"

# Engine Provider Selection
# Options: "mock" (default for local development) or "zoo" (requires ZOO_API_TOKEN)
ENGINE_PROVIDER=mock

# Zoo API Key & Base URL (Placeholders only — DO NOT commit real credentials!)
ZOO_API_TOKEN=
ZOO_API_BASE_URL="https://api.zoo.dev"
GENERATION_TIMEOUT_SECONDS=30.0

# Analysis Provider Selection
# Options: "mock" (default) or "gemini" (requires GEMINI_API_KEY)
ANALYSIS_PROVIDER=mock

# Gemini Vision API Key & Model Configuration (Placeholders only — DO NOT commit real credentials!)
GEMINI_API_KEY=
GEMINI_VISION_MODEL="gemini-2.5-flash-lite"
GEMINI_VISION_FALLBACK_MODEL="gemini-2.5-flash"
GEMINI_VISION_FALLBACK_ENABLED=true
ANALYSIS_TIMEOUT_SECONDS=30.0

