// InterfaceForge — Deterministic KCL Adapter Model
// Compiler Version: 1.0.0
// Schema Version: 0.1
// Schema Revision: 1
// Units: Millimeters (mm)

@settings(defaultLengthUnit = mm)

// --- Interface A Parameters ---
const interface_a_type = "circle"
const interface_a_outer_diameter_mm = 60.000
const interface_a_clearance_mm = 0.300

// --- Interface B Parameters ---
const interface_b_type = "circle"
const interface_b_outer_diameter_mm = 40.000
const interface_b_clearance_mm = 0.100

// --- Connection & Manufacturing Parameters ---
const connection_mode = "angled"
const transition_length_mm = 70.000
const wall_thickness_mm = 3.000
const offset_x_mm = 10.000
const offset_y_mm = 5.000
const angle_deg = 20.000

// --- 3D Geometry Construction ---
const top_plane = plane(origin = [10.000, 5.000, 70.000], xAxis = [1.0, 0.0, 0.0], yAxis = [0.0, 0.93969, 0.34202])

// Outer Profiles
const sketch_outer_a = startSketchOn('XY')
  |> circle(center = [0.000, 0.000], radius = 29.700)
const sketch_outer_b = startSketchOn(top_plane)
  |> circle(center = [0.000, 0.000], radius = 19.900)

const outer_solid = loft([sketch_outer_a, sketch_outer_b])

// Inner Profiles
const sketch_inner_a = startSketchOn('XY')
  |> circle(center = [0.000, 0.000], radius = 26.700)
const sketch_inner_b = startSketchOn(top_plane)
  |> circle(center = [0.000, 0.000], radius = 16.900)

const inner_void = loft([sketch_inner_a, sketch_inner_b])

const adapter_model = subtract(outer_solid, tools = [inner_void])
